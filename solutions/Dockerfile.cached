# Stage 2 — Cached: smaller base, layer-cache friendly.
#
# What changed vs naive:
#   - python:3.12-slim instead of python:3.12 (~150 MB vs ~1 GB).
#   - requirements.txt copied first → pip layer cached across code edits.
#   - --no-cache-dir so pip does not leave its cache inside the image.
#   - Code files copied explicitly instead of "COPY . .".
#
# Still bad (Stage 3 fixes these):
#   - Runs as root.
#   - No healthcheck.

FROM python:3.12-slim

WORKDIR /app

# Dependencies first — their layer survives code-only changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code — touching these does not invalidate the layer above.
COPY app.py products.json ./
COPY templates ./templates

EXPOSE 5000

CMD ["python", "app.py"]
